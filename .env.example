# Copie este arquivo para .env e preencha. O .env nunca vai pro Git.

# ---------------------------------------------------------------------------
# Supabase -> Connect (botão no topo do painel) -> ORM / Prisma
# São DUAS strings diferentes. Não dá pra usar a mesma nas duas.
# ---------------------------------------------------------------------------

# Transaction pooler, porta 6543. É a que o APP usa.
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Session pooler, porta 5432. É a que as MIGRATIONS usam.
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Senha com que você entra no sistema (mínimo 8 caracteres).
SENHA_ACESSO="troque-isto"

# Assina o cookie de sessão. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="gere-uma-chave-de-32-bytes"

# Protege a URL do calendário. Quem tiver este token vê toda a sua agenda,
# então trate como senha. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALENDAR_TOKEN="gere-um-token-aleatorio"

# Protege a rota que mantém o banco do Supabase acordado.
# Na Vercel, criar esta variável faz o agendador enviá-la sozinho.
CRON_SECRET="gere-um-token-aleatorio"

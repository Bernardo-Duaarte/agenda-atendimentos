// Convenções deste schema:
//
// 1. Dinheiro é sempre Int em CENTAVOS. Nunca Float — 0.1 + 0.2 != 0.3 em ponto
//    flutuante, e num relatório de faturamento isso vira centavo sumido.
// 2. Datas são sempre gravadas em UTC. A conversão para America/Sao_Paulo
//    acontece só na exibição (ver src/lib/tempo.ts).
// 3. Estoque NUNCA é um campo editável. O saldo de um produto é a soma dos
//    MovimentoEstoque dele. Assim sempre dá para responder "por que sumiu base?".

// No Prisma 7 a URL do banco não mora mais aqui — ela fica em prisma.config.ts
// (para as migrations) e no adaptador de driver em src/lib/prisma.ts (para o app).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LocalAtendimento {
  ESTUDIO
  DOMICILIO
}

enum StatusAgendamento {
  PRE_AGENDAMENTO // conversa inicial: data combinada, sinal ainda não pago
  PENDENTE        // fechado, aguardando o sinal
  CONFIRMADO      // sinal pago, horário garantido
  CONCLUIDO
  CANCELADO
  FALTOU // no-show: contabiliza separado de cancelado, é métrica diferente
}

enum TipoPagamento {
  SINAL     // entrada que confirma o horário
  RESTANTE  // o que falta, normalmente no dia
  EXTRA     // algo cobrado além do combinado
  DEVOLUCAO // valor devolvido à cliente
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO
  TRANSFERENCIA
}

enum TipoMovimento {
  ENTRADA // compra de produto
  CONSUMO // baixa automática ao concluir um atendimento
  PERDA   // vencimento, quebra, derramou
  AJUSTE  // correção após contagem manual
}

model Cliente {
  id             String    @id @default(cuid())
  nome           String
  telefone       String // E.164 sem o '+': 5511999999999
  email          String?
  dataNascimento DateTime? @db.Date

  // Ficha técnica da cliente — é o que mais se consulta antes de um atendimento
  tomPele     String?
  alergias    String?
  observacoes String?

  // Endereço usado como sugestão ao criar atendimento em domicílio
  enderecoPadrao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agendamentos Agendamento[]

  @@index([nome])
  @@index([telefone])
}

model Servico {
  id            String  @id @default(cuid())
  nome          String
  descricao     String?
  precoCentavos Int
  duracaoMin    Int
  ativo         Boolean @default(true)

  /// Quanto do preço se pede de sinal para garantir o horário, em porcento.
  /// Fica no serviço, e não numa configuração única, porque noiva e social
  /// não precisam ter a mesma regra. O valor ainda pode ser ajustado em um
  /// atendimento específico.
  percentualSinal Int @default(30)

  /// Sinal em valor fixo, em centavos, quando a porcentagem não serve.
  ///
  /// Existe porque há serviço cujo preço varia mas o sinal é sempre o mesmo —
  /// uma noiva de R$ 900 ou de R$ 1.500 pode ter o mesmo sinal combinado. Com
  /// porcentagem, cada preço daria um sinal diferente.
  ///
  /// Nulo significa "usa a porcentagem". É nulo, e não zero, porque zero é uma
  /// resposta legítima: serviço que não pede sinal nenhum.
  sinalFixoCentavos Int?

  /// Este serviço é feito por uma parceira, e não por você?
  ///
  /// Quando sim, o atendimento exige escolher a profissional e o preço vem da
  /// tabela dela — cada penteadista cobra o seu. Quando não, quem faz é você.
  exigeProfissional Boolean @default(false)

  /// Acréscimos sobre o preço base, em centavos.
  ///
  /// São ACRÉSCIMOS e não preços alternativos porque as duas condições se
  /// somam: um domicílio num domingo paga as duas. Com preços alternativos
  /// seria preciso cadastrar uma tabela de quatro valores por serviço, e ela
  /// sairia de sincronia no primeiro reajuste.
  ///
  /// Zero significa "não cobro diferente nessa condição".
  acrescimoDomicilioCentavos  Int @default(0)
  acrescimoForaHorarioCentavos Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agendamentos Agendamento[]
  insumos      ServicoProduto[]
}

model Produto {
  id      String  @id @default(cuid())
  nome    String
  marca   String?
  unidade String // "ml", "g", "un", "aplicacao"

  /// Quanto vem em UMA embalagem, na unidade acima (35 ml, 12 g, 1 un).
  /// Existe para você cadastrar do jeito que compra — "frasco de 35 ml por
  /// R$ 229" — e o sistema fazer a divisão sozinho.
  conteudoEmbalagem Decimal @db.Decimal(10, 3)

  /// Custo de UMA unidade (1 ml, 1 g, 1 un), em centavos. Você nunca digita
  /// isto: ele é derivado da compra (preço pago ÷ quantidade da embalagem).
  /// É por unidade porque a ficha técnica consome por unidade — guardar o
  /// preço do frasco aqui faria 4 ml de base custarem um frasco inteiro.
  custoUnitarioCentavos Int
  estoqueMinimo Decimal   @default(0) @db.Decimal(10, 3)
  validade      DateTime? @db.Date
  ativo         Boolean   @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usadoEm    ServicoProduto[]
  movimentos MovimentoEstoque[]

  @@index([nome])
}

/// Ficha técnica: quanto de cada produto um serviço consome, em média.
/// É isso que permite a baixa automática de estoque e o custo real por atendimento.
model ServicoProduto {
  id         String  @id @default(cuid())
  servicoId  String
  produtoId  String
  quantidade Decimal @db.Decimal(10, 3)

  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([servicoId, produtoId])
}

model Agendamento {
  id        String @id @default(cuid())
  clienteId String
  servicoId String

  /// Início e fim DO ATENDIMENTO em si, em UTC. É o que a cliente vê.
  inicio DateTime
  fim    DateTime

  local    LocalAtendimento @default(ESTUDIO)
  endereco String?

  /// Deslocamento em minutos. A agenda fica ocupada de
  /// (inicio - deslocamentoIdaMin) até (fim + deslocamentoVoltaMin) — é essa
  /// janela, e não inicio/fim, que a verificação de conflito usa.
  deslocamentoIdaMin       Int @default(0)
  deslocamentoVoltaMin     Int @default(0)
  taxaDeslocamentoCentavos Int @default(0)

  status StatusAgendamento @default(PENDENTE)

  /// Cópia do preço do serviço no momento do agendamento. Se o preço da tabela
  /// mudar depois, o histórico de faturamento não pode mudar junto.
  precoCentavos Int

  /// Quanto foi combinado de sinal. Nasce do percentual do serviço e vira
  /// cópia aqui pelo mesmo motivo do preço: mudar a regra amanhã não pode
  /// reescrever o que já foi combinado ontem.
  sinalCentavos Int @default(0)

  /// Quem vai atender. Nulo significa você.
  ///
  /// É o que decide conflito de horário: dois atendimentos só brigam quando
  /// exigem a MESMA pessoa. Você maquiando uma cliente e a Giselle penteando
  /// outra acontecem ao mesmo tempo sem problema — e duas clientes com a
  /// Giselle no mesmo horário, não.
  profissionalId String?

  /// Quanto será repassado à profissional, congelado no agendamento pelo mesmo
  /// motivo do preço: reajustar a tabela dela amanhã não pode reescrever o
  /// que foi combinado ontem.
  repasseCentavos Int @default(0)

  /// Distância de UM trecho, guardada junto com o atendimento.
  ///
  /// Existe para o valor cobrado ter explicação meses depois — "essa taxa veio
  /// de 12 km" — e para não depender de consultar o mapa de novo, já que o
  /// trajeto e o trânsito de hoje não são os de quando foi combinado.
  distanciaMetros Int?

  observacoes String?

  lembreteEnviadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico      Servico       @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  movimentos MovimentoEstoque[]
  pagamentos Pagamento[]

  @@index([inicio])
  @@index([status, inicio])
  // Chave estrangeira sem índice faz o Postgres varrer a tabela inteira a cada
  // exclusão de cliente ou serviço (por causa do ON DELETE RESTRICT), e também
  // ao listar o histórico de uma cliente.
  @@index([clienteId])
  @@index([servicoId])
  @@index([profissionalId])
}

/// Penteadistas parceiras: fazem o atendimento no lugar dela, com preço próprio.
///
/// A cliente paga a ela, que repassa à profissional. Por isso existem os dois
/// valores: o que entra e o que sai.
model Profissional {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  /// O que a cliente paga por um atendimento com esta profissional.
  precoCentavos Int

  /// O que é repassado a ela. Igual ao preço quando não há margem.
  repasseCentavos Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agendamentos Agendamento[]

  @@index([nome])
}

/// Livro-razão do estoque. Só se escreve aqui, nunca se edita saldo direto.
model MovimentoEstoque {
  id            String  @id @default(cuid())
  produtoId     String
  agendamentoId String?

  tipo TipoMovimento

  /// Quantidade COM SINAL: positiva para ENTRADA, negativa para CONSUMO e
  /// PERDA, qualquer sinal para AJUSTE. Assim o saldo é um SUM() simples.
  quantidade Decimal @db.Decimal(10, 3)

  /// Quanto foi pago NA COMPRA INTEIRA deste lançamento, para ENTRADA.
  /// Total, não unitário: é o número que aparece no cupom. O custo unitário
  /// sai daqui dividido pela quantidade.
  custoTotalCentavos Int?

  observacao String?
  criadoEm   DateTime @default(now())

  produto     Produto      @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  @@index([produtoId])
  @@index([agendamentoId])
}

/// Linha única de configuração. Como o sistema é de uso pessoal, não existe
/// tabela de usuários — o id é fixo em "unica".
model Configuracao {
  id String @id @default("unica")

  nomeProfissional String  @default("")
  telefone         String  @default("")
  enderecoEstudio  String?

  /// Horário e dias de trabalho — e, por consequência, quando vale o preço
  /// normal. Um atendimento que começa fora desta janela cobra o preço
  /// diferenciado do serviço, quando ele tiver um.
  ///
  /// São a MESMA coisa de propósito: separar "quando eu trabalho" de "quando
  /// custa mais" criaria dois pares de horários quase iguais para manter em
  /// sincronia, e a diferença entre eles não existe na prática.
  horaAbertura   String @default("07:00")
  horaFechamento String @default("21:00")

  /// Dias de trabalho, pelo número da semana: 1 = segunda ... 7 = domingo.
  /// O padrão exclui o domingo.
  diasNormais String @default("1,2,3,4,5,6")

  /// Endereço do seu calendário pessoal publicado, para a agenda mostrar seus
  /// compromissos junto e avisar de choque.
  ///
  /// É só leitura: o iPhone não deixa site nenhum escrever no Calendário, e
  /// um evento de lá não tem cliente nem preço para virar atendimento.
  calendarioExternoUrl String?

  /// Fórmula da taxa de deslocamento, no formato em que o Uber cobra:
  /// base + (por km × km) + (por minuto × minutos), tudo em centavos.
  ///
  /// É estimativa, não consulta: não existe API pública do Uber para preço de
  /// corrida. Estes três números são seus, calibrados pelo que você observa —
  /// e por isso ficam editáveis em vez de fixos no código.
  taxaBaseCentavos      Int @default(0)
  taxaPorKmCentavos     Int @default(0)
  taxaPorMinutoCentavos Int @default(0)

  atualizadoEm DateTime @updatedAt
}

/// Registro de tentativas de entrada, para travar força bruta.
///
/// Mora no banco, e não em memória, porque em ambiente serverless cada
/// instância teria o próprio contador — e quem estivesse tentando adivinhar a
/// senha só precisaria cair em instâncias diferentes para nunca ser barrado.
model TentativaAcesso {
  id       String   @id @default(cuid())
  ip       String
  sucesso  Boolean
  criadoEm DateTime @default(now())

  @@index([ip, criadoEm])
  @@index([criadoEm])
}

/// Cada recebimento, um registro.
///
/// É uma tabela e não um campo "valorPago" porque o sinal pode vir em duas
/// vezes, o restante pode ser dividido, e a data de cada entrada importa para
/// saber quanto entrou no mês. Um campo só apagaria essa história.
///
/// Mesmo princípio do livro-razão do estoque: só se escreve, e o total é uma
/// soma. Por isso a DEVOLUÇÃO é um valor negativo em vez de apagar a entrada.
model Pagamento {
  id            String @id @default(cuid())
  agendamentoId String

  tipo  TipoPagamento
  forma FormaPagamento

  /// COM SINAL: positivo para o que entra, negativo para DEVOLUCAO.
  valorCentavos Int

  /// Quando o dinheiro entrou de fato, que pode não ser quando foi lançado.
  pagoEm     DateTime
  observacao String?
  criadoEm   DateTime @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@index([pagoEm])
}
